/* app.wxss - 全局样式文件 */

/* 全局字体和颜色变量 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: #333333;
  background-color: #F5F7FA;
}

/* ============ 通用组件样式 ============ */

/* 主色调按钮 */
.btn-primary {
  background: linear-gradient(135deg, #4A90D9, #357ABD);
  color: #FFFFFF;
  border-radius: 48rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.3);
}

/* 次要按钮 */
.btn-secondary {
  background: #FFFFFF;
  color: #4A90D9;
  border: 2rpx solid #4A90D9;
  border-radius: 48rpx;
  padding: 22rpx 0;
  font-size: 32rpx;
  text-align: center;
}

/* 卡片容器 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* 风险等级标签 */
.risk-tag {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
}
.risk-normal { background: #E8F5E9; color: #388E3C; }
.risk-low { background: #E3F2FD; color: #1976D2; }
.risk-medium { background: #FFF8E1; color: #F57F17; }
.risk-high { background: #FFEBEE; color: #C62828; }

/* 分割线 */
.divider {
  height: 1rpx;
  background: #EEEEEE;
  margin: 24rpx 0;
}

/* 页面标题 */
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

/* 副标题 */
.page-subtitle {
  font-size: 28rpx;
  color: #888888;
}

/* 空状态提示 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #BBBBBB;
  font-size: 28rpx;
}

/* 加载动画容器 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx 0;
}
