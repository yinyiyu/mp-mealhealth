/* pages/assessment/assessment.wxss */

.page-container {
  min-height: 100vh;
  background: #F5F7FA;
}

/* 欢迎横幅 */
.welcome-banner {
  background: linear-gradient(135deg, #4A90D9, #5BA8E8);
  padding: 48rpx 40rpx 60rpx;
  color: #FFFFFF;
}

.greeting {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  opacity: 0.85;
}

/* 列表区域 */
.list-section {
  margin-top: -24rpx;
  padding: 0 24rpx 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  padding: 32rpx 8rpx 20rpx;
}

/* 测评卡片 */
.assessment-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  position: relative;
  overflow: hidden;
}

.assessment-card.completed {
  opacity: 0.85;
}

.assessment-card.completed::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 8rpx;
  height: 100%;
  background: #52C41A;
  border-radius: 4rpx 0 0 4rpx;
}

/* 已完成角标 */
.completed-badge {
  position: absolute;
  top: 0;
  right: 0;
  background: #52C41A;
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 0 24rpx 0 24rpx;
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
  flex: 1;
  margin-right: 16rpx;
  line-height: 1.4;
}

.status-tag {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}

.status-ongoing {
  background: #E8F5E9;
  color: #388E3C;
}

.status-ended {
  background: #F5F5F5;
  color: #9E9E9E;
}

/* 元信息 */
.card-meta {
  margin-bottom: 24rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #666666;
}

.meta-icon {
  margin-right: 12rpx;
}

/* 操作按钮 */
.card-action {
  display: flex;
  justify-content: flex-end;
  margin-top: 8rpx;
}

.action-btn {
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.start-btn {
  background: linear-gradient(135deg, #4A90D9, #357ABD);
  color: #FFFFFF;
}

.view-btn {
  background: #F0F7FF;
  color: #4A90D9;
  border: 2rpx solid #C8E0F8;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
  color: #BBBBBB;
}

.empty-img {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

.empty-sub {
  font-size: 24rpx;
  margin-top: 12rpx;
}

/* 加载中 */
.loading-dots {
  display: flex;
  gap: 12rpx;
  justify-content: center;
  padding: 60rpx 0;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  background: #4A90D9;
  border-radius: 50%;
}

.load-more-tip {
  text-align: center;
  font-size: 24rpx;
  color: #BBBBBB;
  padding: 24rpx 0;
}
