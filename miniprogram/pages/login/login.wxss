/* pages/login/login.wxss - 登录页面样式 */

.login-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #EAF4FF 0%, #F5F7FA 50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx 40rpx;
}

/* 顶部Logo区域 */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #2C3E50;
  margin-bottom: 12rpx;
}

.app-slogan {
  font-size: 26rpx;
  color: #7F8C8D;
}

/* 登录方式切换标签 */
.mode-tabs {
  display: flex;
  background: #FFFFFF;
  border-radius: 48rpx;
  padding: 8rpx;
  margin-bottom: 48rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  width: 100%;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  color: #888888;
  border-radius: 40rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: #4A90D9;
  color: #FFFFFF;
  font-weight: 500;
}

/* 微信登录区域 */
.wechat-login-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.wechat-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
}

.tips {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 48rpx;
}

.wechat-btn {
  width: 100%;
  background: #07C160;
  color: #FFFFFF;
  border-radius: 48rpx;
  padding: 28rpx 0;
  font-size: 34rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
}

/* 账号密码表单 */
.form-area {
  width: 100%;
}

.form-item {
  margin-bottom: 32rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #555555;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.input {
  width: 100%;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  border: 2rpx solid #E8ECEF;
  box-sizing: border-box;
}

.login-btn {
  width: 100%;
  margin-top: 16rpx;
  padding: 28rpx 0;
  font-size: 34rpx;
}

/* 隐私声明 */
.privacy-notice {
  position: fixed;
  bottom: 60rpx;
  font-size: 22rpx;
  color: #AAAAAA;
  text-align: center;
  padding: 0 48rpx;
}

.link {
  color: #4A90D9;
}
