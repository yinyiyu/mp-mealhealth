/* pages/profile/profile.wxss */
.page-container {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: 60rpx;
}

.avatar-section {
  background: linear-gradient(135deg, #4A90D9, #5BA8E8);
  padding: 60rpx 40rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  color: #FFFFFF;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 64rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.username {
  font-size: 40rpx;
  font-weight: 600;
}

.role-tag {
  background: rgba(255, 255, 255, 0.25);
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin: -32rpx 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.card-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
}

.edit-btn {
  font-size: 28rpx;
  color: #4A90D9;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.info-row:last-child { border-bottom: none; }

.info-label {
  font-size: 28rpx;
  color: #888888;
  width: 120rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333333;
  flex: 1;
  text-align: right;
}

.form-row {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 10rpx;
}

.form-input {
  background: #F8F9FA;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  border: 1rpx solid #E8ECF0;
  width: 100%;
  box-sizing: border-box;
}

.save-btn {
  margin-top: 24rpx;
  width: 100%;
}

.logout-btn {
  margin: 0 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  text-align: center;
  color: #F5222D;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}
