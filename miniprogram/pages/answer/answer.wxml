<!--pages/answer/answer.wxml - 答题页面模板-->
<view class="answer-page">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-full">
    <view class="loading-text">加载题目中...</view>
  </view>

  <block wx:else>
    <!-- 顶部进度条 -->
    <view class="top-bar">
      <view class="progress-info">
        <text class="progress-text">{{currentIndex + 1}} / {{totalQuestions}}</text>
        <view class="progress-bar-bg">
          <view
            class="progress-bar-fill"
            style="width: {{(currentIndex + 1) / totalQuestions * 100}}%"
          ></view>
        </view>
      </view>

      <!-- 计时器（有限时才显示） -->
      <view wx:if="{{maxDurationMinutes}}" class="timer {{isOvertime ? 'overtime' : ''}}">
        <text class="timer-icon">⏱</text>
        <text class="timer-text">{{timerText}}</text>
      </view>

      <!-- 进度概览按钮 -->
      <view class="progress-btn" bindtap="toggleProgress">
        <text>{{answeredCount}}/{{totalQuestions}}</text>
        <text class="progress-btn-icon">≡</text>
      </view>
    </view>

    <!-- 答题进度面板（侧滑展示） -->
    <view wx:if="{{showProgress}}" class="progress-panel" catchtap="toggleProgress">
      <view class="progress-panel-content" catchtap="">
        <view class="panel-title">答题进度</view>
        <view class="question-grid">
          <view
            wx:for="{{questions}}"
            wx:key="id"
            class="grid-item {{currentIndex === index ? 'current' : ''}} {{answers[item.id] ? 'answered' : ''}}"
            bindtap="onJumpToQuestion"
            data-index="{{index}}"
          >
            {{index + 1}}
          </view>
        </view>
        <view class="legend">
          <view class="legend-item">
            <view class="legend-dot answered-dot"></view>
            <text>已回答</text>
          </view>
          <view class="legend-item">
            <view class="legend-dot current-dot"></view>
            <text>当前题</text>
          </view>
          <view class="legend-item">
            <view class="legend-dot unanswered-dot"></view>
            <text>未回答</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 当前题目 -->
    <view class="question-area" wx:if="{{questions.length > 0}}">
      <view class="question-container">
        <!-- 题目内容 -->
        <view class="question-header">
          <view class="question-type-tag">
            {{questions[currentIndex].question_type === 'single_choice' ? '单选题' : '多选题'}}
          </view>
          <view
            wx:if="{{questions[currentIndex].is_required}}"
            class="required-tag"
          >
            必答
          </view>
        </view>
        <view class="question-content">
          <text class="question-num">{{currentIndex + 1}}. </text>
          <text class="question-text">{{questions[currentIndex].content}}</text>
        </view>

        <!-- 选项列表 -->
        <view class="options-list">
          <view
            wx:for="{{questions[currentIndex].options}}"
            wx:key="label"
            class="option-item {{answers[questions[currentIndex].id] === item.label ||
              (answers[questions[currentIndex].id] && answers[questions[currentIndex].id].includes && answers[questions[currentIndex].id].includes(item.label)) ? 'selected' : ''}}"
            bindtap="onSelectOption"
            data-question-id="{{questions[currentIndex].id}}"
            data-option-label="{{item.label}}"
            data-question-type="{{questions[currentIndex].question_type}}"
          >
            <view class="option-label-box">
              <text class="option-label">{{item.label}}</text>
            </view>
            <text class="option-text">{{item.text}}</text>
            <!-- 选中图标 -->
            <view class="check-icon">
              <text wx:if="{{answers[questions[currentIndex].id] === item.label ||
                (answers[questions[currentIndex].id] && answers[questions[currentIndex].id].includes && answers[questions[currentIndex].id].includes(item.label))}}">✓</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部导航按钮 -->
    <view class="bottom-nav">
      <button
        class="nav-btn prev-btn"
        bindtap="onPrev"
        disabled="{{currentIndex === 0}}"
      >
        ‹ 上一题
      </button>

      <view class="nav-dots">
        <text class="dot-text">{{currentIndex + 1}}/{{totalQuestions}}</text>
      </view>

      <button
        class="nav-btn next-btn {{currentIndex === totalQuestions - 1 ? 'submit-btn' : ''}}"
        bindtap="onNext"
        loading="{{submitting}}"
      >
        {{currentIndex === totalQuestions - 1 ? '提交测评' : '下一题 ›'}}
      </button>
    </view>
  </block>
</view>
